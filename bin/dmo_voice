#!/bin/sh
# dmo_voice: TCH-записи з dmo_rx (.tch) -> WAV (8 кГц, mono, int16) через ETSI-кодек, встановлений
# у /tetra/bin (каталог - TETRA_CODEC_DIR). Кодек викликається як є. Без другого аргументу вихід - <ім'я>_audio.wav.
set -eu
CODEC_DIR="${TETRA_CODEC_DIR:-/tetra/bin}"
in="${1:?usage: dmo_voice <file.tch> [out.wav]}"
out="${2:-${in%.*}_audio.wav}"
[ -r "$in" ] || { echo "dmo_voice: cannot read $in" >&2; exit 1; }
cat "$in" | "$CODEC_DIR/cdecoder" /dev/stdin /dev/stdout 2>/dev/null | "$CODEC_DIR/sdecoder" /dev/stdin /dev/stdout 2>/dev/null |
python3 -c '
import sys, wave
data = sys.stdin.buffer.read()
if not data:
    sys.exit("dmo_voice: the codec produced no audio")
w = wave.open(sys.argv[1], "wb")
w.setnchannels(1); w.setsampwidth(2); w.setframerate(8000)
w.writeframes(data)
w.close()
print("-> %s (%.1f s)" % (sys.argv[1], len(data) / 2 / 8000))' "$out"
